{
  "name": "webmcp-comparer",
  "version": "0.1.0",
  "private": true,
  "description": "Runs the same Scenario on the same website in a Baseline lane and a WebMCP lane side by side and compares them.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=server server/main.ts --dev",
    "build": "vite build",
    "start": "npm run build && node server/main.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test -c e2e",
    "prices:check": "node server/pricing/prices-check.ts",
    "live-check": "node server/agent/live-check.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.81",
    "@ai-sdk/openai": "4.0.95",
    "@fastify/middie": "9.3.5",
    "@fastify/static": "10.1.6",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@vitejs/plugin-react": "6.1.2",
    "ai": "7.0.142",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "monaco-editor": "0.57.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "happy-dom": "21.0.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
