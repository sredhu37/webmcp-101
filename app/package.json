{
  "name": "webmcp-shop",
  "version": "1.0.0",
  "private": true,
  "description": "A small React demo shop with no WebMCP tools. Add them yourself, step by step.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite build && node server.js",
    "dev": "node --watch-path=server.js --watch-path=products.js server.js --dev",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "5.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "webmcp-types": "0.1.10"
  }
}
